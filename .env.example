# Discogs OAuth 1.0a — create your own app at https://www.discogs.com/settings/developers
# then copy the Consumer Key & Secret here.
DISCOGS_CONSUMER_KEY=your_consumer_key
DISCOGS_CONSUMER_SECRET=your_consumer_secret

# Filled in by `npm run discogs:auth` (the one-time OAuth dance)
DISCOGS_OAUTH_TOKEN=
DISCOGS_OAUTH_TOKEN_SECRET=

# Max request body size for adapter-node (photo uploads). Supports K/M/G suffixes.
BODY_SIZE_LIMIT=10M

# Override default ./data storage location (set on the Linux server to a persistent path)
# DATA_DIR=/var/lib/mynyl
