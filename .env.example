# Discogs API v2 — create your own app at https://www.discogs.com/settings/developers.
# Optional but recommended: without these the app still works unauthenticated
# (25 req/min); with them you get the high tier (60 req/min) and guaranteed images.
DISCOGS_CONSUMER_KEY=your_consumer_key
DISCOGS_CONSUMER_SECRET=your_consumer_secret

# Max request body size for adapter-node. Sized for RESTORE uploads (a
# media-heavy backup zip can be well over 10M); photo uploads are separately
# capped at 25MB per file in their route. Supports K/M/G suffixes.
BODY_SIZE_LIMIT=512M

# Host port for the Docker deployment (container always listens on 3000 internally).
SPINDLE_PORT=3737

# Override default ./data storage location (set on the Linux server to a persistent path)
# DATA_DIR=/var/lib/spindle
