{
	"name": "spindle",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"overrides": {
		"cookie": "^0.7.2"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"smoke:db": "esbuild scripts/smoke-db.ts --bundle --platform=node --format=cjs \"--alias:$lib=./src/lib\" --external:better-sqlite3 --outfile=.smoke.cjs && node .smoke.cjs && rm -f .smoke.cjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/archiver": "^8.0.0",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^26.3.0",
		"@types/unzipper": "^0.10.11",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@zxing/browser": "^0.2.1",
		"@zxing/library": "^0.23.0",
		"archiver": "^8.0.0",
		"better-sqlite3": "^13.0.3",
		"unzipper": "^0.12.5"
	}
}
