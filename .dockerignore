# VCS + editor
.git
.gitignore
.vscode
.DS_Store

# Dependencies — installed fresh per stage inside the image (never shipped from the host)
node_modules

# Build output + generated files (the build runs in-image)
/build
.output
.svelte-kit
*.tsbuildinfo
vite.config.ts.timestamp-*
.smoke.cjs

# Runtime data — bind-mounted at ./data, never baked into the image
/data

# Secrets / local config — enter the container only via compose env at run time
.env
.env.*

# Docs + non-runtime (keeps the context and image lean)
/plans
/references
/scripts
*.md
